
@{
    Layout = null;
}
@model WebMusic.Models.UserViewModel

<head>
    <meta name="viewport" content="width=device-width" />
    <title>EditProfile</title>
    <link href="~/Content/css/profile-edit.css" rel="stylesheet" />
</head>

@Html.Partial("_Header")
<h2>Chỉnh Sửa Hồ Sơ</h2>

@using (Html.BeginForm("EditProfile", "Profile", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="profile-edit-form">
        <div class="form-group">
            <label>Họ và Tên</label>
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            <label>Email</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required" })
        </div>

        <div class="form-group">
            <label>Số Điện Thoại</label>
            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Địa Chỉ</label>
            @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Ảnh Đại Diện</label>
            <input type="file" name="avatarFile" class="form-control" />
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-primary">Lưu Thay Đổi</button>
            <a href="@Url.Action("ProfileUser", "Profile")" class="btn btn-secondary">Hủy</a>
        </div>

    </div>
}
@Html.Partial("_Footer")

