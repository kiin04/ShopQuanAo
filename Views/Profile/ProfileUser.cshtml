@{
    Layout = null;
}

<link href="~/Content/css/profile.css" rel="stylesheet" />

@Html.Partial("_Header")
<div class="profile-container">
    <h2>Thông Tin Cá Nhân</h2>

    <div class="profile-pic">
        <img src="@(Session["Avatar"] ?? "/Content/images/7.jpg")" alt="Avatar" />
    </div>

    <div class="profile-info">
        <p><strong>Họ và Tên:</strong> @Session["FullName"]</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Số Điện Thoại:</strong> @(Session["Phone"] ?? "Chưa cập nhật")</p>
        <p><strong>Địa Chỉ:</strong> @(Session["Address"] ?? "Chưa cập nhật")</p>
        <p><strong>Vai trò:</strong> @(Session["Role"] != null ? Session["Role"].ToString() : "Admin")</p>
    </div>

    <div class="profile-actions">
        <a href="@Url.Action("EditProfile", "Profile")" class="btn-edit">Chỉnh Sửa</a>
        <a href="@Url.Action("Logout", "Login")" class="btn-logout">Đăng Xuất</a>
        @if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
        {
            <a href="@Url.Action("Dashboard", "Admin")" class="btn-admin">Admin</a>
        }
    </div>
</div>

<!-- Modal (Popup) -->
<div id="orderDetailsModal" class="modal">
    <div class="modal-content">
        <span class="close-btn">&times;</span>
        <div id="orderDetailsContent">
            <!-- Chi tiết đơn hàng sẽ được hiển thị ở đây -->
        </div>
    </div>
</div>

@if (Session["Role"] == null || Session["Role"].ToString() != "Admin")
{
    <div class="purchase-history">
        <h3>Lịch Sử Mua Hàng</h3>
        <button id="showOrders" class="btn-show-orders">Xem Đơn Hàng</button>
        <div id="orderList" style="display: none;">
            @if (Model.Orders != null && Model.Orders.Count > 0)
            {
                <div class="order-list">
                    @foreach (var order in Model.Orders)
                    {
                        <div class="order-item">
                            <div class="order-details">
                                <p><strong>Mã đơn hàng:</strong> @order.OrderID</p>
                                <p><strong>Ngày mua:</strong> @order.OrderDate.ToString("dd/MM/yyyy")</p>
                                <p><strong>Tổng tiền:</strong> @order.TotalAmount.ToString("N0") VND</p>
                                <p><strong>Trạng thái:</strong> @order.Status</p>
                            </div>
                            <button class="btn-detail" data-orderid="@order.OrderID">Xem Chi Tiết</button>
                            <script>
                                document.getElementById("showOrders")?.addEventListener("click", function () {
                                    var orderList = document.getElementById("orderList");
                                    orderList.style.display = (orderList.style.display === "none" || orderList.style.display === "") ? "block" : "none";
                                });

                                // Mở modal khi bấm vào "Xem Chi Tiết"
                                var detailButtons = document.querySelectorAll(".btn-detail");
                                detailButtons.forEach(function (button) {
                                    button.addEventListener("click", function () {
                                        var orderId = this.getAttribute("data-orderid");
                                        fetchOrderDetails(orderId);
                                    });
                                });

                                // Fetch dữ liệu chi tiết đơn hàng bằng Ajax
                                function fetchOrderDetails(orderId) {
                                fetch('@Url.Action("OrderDetails", "Profile", new { orderId = "__orderId__" })'.replace('__orderId__', orderId))
                                    .then(response => response.text())
                                    .then(data => {
                                        document.getElementById("orderDetailsContent").innerHTML = data;
                                        document.getElementById("orderDetailsModal").style.display = "block";
                                    });
                            }

                                // Đóng modal khi nhấn vào nút đóng
                                document.querySelector(".close-btn").addEventListener("click", function () {
                                    document.getElementById("orderDetailsModal").style.display = "none";
                                });

                                // Đóng modal nếu nhấn ra ngoài modal
                                window.onclick = function (event) {
                                    if (event.target === document.getElementById("orderDetailsModal")) {
                                        document.getElementById("orderDetailsModal").style.display = "none";
                                    }
                                };
                            </script>
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Không có đơn hàng nào.</p>
            }
        </div>
    </div>
}

<script>
    document.getElementById("showOrders")?.addEventListener("click", function () {
        var orderList = document.getElementById("orderList");
        orderList.style.display = (orderList.style.display === "none" || orderList.style.display === "") ? "block" : "none";
    });
</script>
