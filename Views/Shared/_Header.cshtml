<link rel="stylesheet" href="~/Content/css/header.css" />
<header>
    <nav class="navbar navbar-expand-lg bg-white shadow-sm">
        <div class="container">
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <a class="navbar-brand" href="#">ShopQuanAo</a>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Home", "Home")">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("DanhMuc", "DanhMuc")">Danh mục</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Liên hệ</a></li>
                </ul>

                <!-- Custom Search Bar -->
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Tìm kiếm">
                    <button class="search-btn">Tìm</button>
                </div>

                
                <nav class="reg">
                    <ul>
                        @if (Session["Email"] != null)
                        {
                            <li class="user-dropdown">
                                <a href="#" class="user-icon">
                                    <!-- Ảnh đại diện nếu có, nếu không dùng ảnh mặc định -->
                                    <img src="@(Session["Avatar"] ?? "/Content/images/7.jpg")" alt="User Profile" class="profile-pic" />

                                    @if (Session["FullName"] != null)
                                    {
                                        @Session["FullName"]
                                    }
                                    else
                                    {
                                        @Session["Username"]
                                    }
                                    <span class="arrow">▼</span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a href="@Url.Action("ProfileUser", "Profile")">Tài Khoản</a></li>
                                    @if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
                                    {
                                        <li><a href="@Url.Action("Dashboard", "Admin")">Admin</a></li>
                                    }
                                    <li><a href="#">Cài Đặt</a></li>
                                    <li><a href="#">Hỗ Trợ</a></li>
                                    <li><a href="@Url.Action("Logout", "Login")">Đăng Xuất</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li><a href="@Url.Action("Login", "Login")" class="btn btn-primary">Đăng Nhập</a></li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </nav>
</header>
