
@{
    Layout = null;
}
<link href="~/Content/css/login.css" rel="stylesheet" />
<div class="container">
    <div class="header">
        <div class="home-button">
            <a href="@Url.Action("Login", "Login")">
                <img src="~/Content/images/back.png" alt="Back" />
            </a>
        </div>
        <h2>Đăng Ký Tài Khoản</h2>
    </div>
    <!-- Hiển thị thông báo lỗi nếu có -->
    @if (ViewBag.Errors != null && ViewBag.Errors.Count > 0)
    {
        <div class="error-message">
            <ul>
                @foreach (var error in ViewBag.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <!-- Form cần có method="post" và action="/Login/Register" để gửi đến Controller -->
<form method="post" action="/Login/Register" enctype="multipart/form-data">
    <label for="email">Email:</label>
    <input type="text" id="email" name="email" required>

    <label for="passwordhash">Mật khẩu:</label>
    <input type="password" id="passwordhash" name="passwordhash" required>

    <label for="confirm-password">Nhập Lại Mật khẩu:</label>
    <input type="password" id="confirm-password" name="ConfirmPassword" required>

    <label for="fullname">Họ Tên:</label>
    <input type="text" id="fullname" name="fullname" required>

    <label for="phone">Số Điện Thoại:</label>
    <input type="text" id="phone" name="phone" required pattern="[0-9]{10,11}" title="Số điện thoại từ 10-11 chữ số">

    <label for="address">Địa Chỉ:</label>
    <input type="text" id="address" name="address" required>


    <!-- Thêm phần chọn ảnh đại diện -->
    <label for="avatar">Chọn ảnh đại diện:</label>
    <input type="file" id="avatar" name="avatar" accept="image/*">

    <p class="login-press">
        Bạn đã có tài khoản? <a href="@Url.Action("Login", "Login")">Đăng nhập</a>
    </p>

    <button type="submit">Đăng Ký</button>
</form>

</div>
@Html.Partial("_Footer")
