@{
    Layout = null;
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Thanh Toán</title>
    <link rel="stylesheet" href="~/Content/css/thanhtoan.css" />
</head>

@Html.Partial("_Header")

<h2>Thanh Toán</h2>

<div class="checkout-container">
    <!-- Cột trái: Thông tin khách hàng -->
    <div class="customer-info">
        <h3>Thông tin nhận hàng</h3>
        <form method="post" action="/Checkout/ConfirmOrder" id="confirm-order-form">
            <label>Họ và tên:</label>
            <input type="text" name="FullName" value="@ViewBag.FullName" required />

            <label>Email:</label>
            <input type="text" name="Email" value="@ViewBag.Email" required />

            <label>Địa chỉ:</label>
            <input type="text" name="Address" value="@ViewBag.Address" required />

            <label>Số điện thoại:</label>
            <input type="text" name="PhoneNumber" value="@ViewBag.PhoneNumber" required />

            <label>Phương thức thanh toán:</label>
            <select name="PaymentMethod" id="payment-method" required>
                <option value="COD">Thanh toán khi nhận hàng (COD)</option>
                <option value="Online">Thanh toán online (Ví điện tử / Thẻ ngân hàng)</option>
            </select>

            <button type="submit" class="btn-confirm">Xác nhận đặt hàng</button>
        </form>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script>
            document.getElementById('confirm-order-form').addEventListener('submit', function (event) {
                let paymentMethod = document.getElementById('payment-method').value;

                if (paymentMethod === 'Online') {
                    event.preventDefault(); // Ngăn form gửi đi

                    // Chuyển hướng sang VNPay, có thể thêm tham số đơn hàng vào URL nếu cần
                    window.location.href = "http://sandbox.vnpayment.vn/tryitnow/Home/CreateOrder?returnUrl=" + encodeURIComponent(window.location.origin + "/Checkout/VNPayReturn");
                }
            });
        </script>

        <!-- Nút trở lại giỏ hàng -->
        <a href="/Cart/Cart" class="btn-back-cart">← Trở lại giỏ hàng</a>
    </div>

    <!-- Cột phải: Thông tin sản phẩm -->
    <div class="order-summary">
        <h3>Chi tiết đơn hàng</h3>
        <table>
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Giá</th>
                    <th>Tổng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ViewBag.CartItems)
                {
                    <tr>
                        <td>
                            <img src="@item.Product.ImageURL" alt="@item.Product.ProductName" class="cart-product-image">
                        </td>
                        <td>@item.Product.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.Product.Price.ToString("N0") VNĐ</td>
                        <td>@((item.Quantity * item.Product.Price).ToString("N0")) VNĐ</td>
                    </tr>
                }
            </tbody>
        </table>
        <h3>Tổng tiền: <span>@ViewBag.TotalAmount.ToString("N0") VNĐ</span></h3>
    </div>
</div>

@Html.Partial("_Footer")



