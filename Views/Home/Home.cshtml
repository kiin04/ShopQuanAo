@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/HomePage.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Trang chủ | 24hClothesShop</title>
        <link rel="stylesheet" href="@Url.Content("~/Content/css/style.css")" />
</head>
<body>

    <header>
        @Html.Partial("_Header")
    </header>

    <main class="container mt-4">
        <h1 class="text-center">Chào mừng đến với 24hClothesShop</h1>
        <p class="text-center">Khám phá hàng ngàn sản phẩm bạn cần.</p>
        <div class="text-center">
            <a href="@Url.Action("DanhMuc", "DanhMuc")" class="btn btn-success">Bắt đầu mua sắm</a>
        </div>
    </main>

    <div class="banner-container">
        <div class="banner-slide">
            <img src="~/Content/images/bannernam.jpg" alt="Banner 1">
        </div>
        <div class="banner-slide">
            <img src="~/Content/images/bannernam1.jpg" alt="Banner 2">
        </div>
        <div class="banner-slide">
            <img src="~/Content/images/bannernam2.jpg" alt="Banner 3">
        </div>
    </div>


    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let slides = document.querySelectorAll(".banner-slide");
            let currentIndex = 0;

            // Đảm bảo banner đầu tiên hiển thị ngay khi tải trang
            slides[currentIndex].classList.add("active");

            function showNextSlide() {
                slides[currentIndex].classList.remove("active");
                currentIndex = (currentIndex + 1) % slides.length;
                slides[currentIndex].classList.add("active");
            }

            // Chuyển ảnh mỗi 5 giây
            setInterval(showNextSlide, 5000);
        });
    </script>

    <div class="product-categories">
        @{
            bool hasOther = false; // Kiểm tra danh mục "Khác"
        }

        @if (ViewBag.Categories != null)
        {
            foreach (var category in ViewBag.Categories)
            {
                var imagePath = "/Content/images/default.png"; // Ảnh mặc định
                bool isOther = true;

                if (category.CategoryName.Contains("Áo")) { imagePath = "/Content/images/shirt.png"; isOther = false; }
                else if (category.CategoryName.Contains("Quần")) { imagePath = "/Content/images/pants.png"; isOther = false; }
                else if (category.CategoryName.Contains("Phụ Kiện")) { imagePath = "/Content/images/accessories.png"; isOther = false; }
                else if (category.CategoryName.Contains("Giày")) { imagePath = "/Content/images/shoes.png"; isOther = false; }

                if (!isOther)
                {
                    <a href="@Url.Action("DanhMuc", "DanhMuc", new { categoryId = category.CategoryID })" class="category-link">
                        <div class="category-item">
                            <img src="@Url.Content(imagePath)" alt="@category.CategoryName">
                            <p>@category.CategoryName</p>
                        </div>
                    </a>
                }
                else
                {
                    hasOther = true;
                }
            }
        }

        @if (hasOther)
        {
            <a href="@Url.Action("DanhMuc", "DanhMuc", new { categoryId = "other" })" class="category-link">
                <div class="category-item">
                    <img src="@Url.Content("/Content/images/more.png")" alt="More">
                    <p>Khác</p>
                </div>
            </a>
        }
    </div>

    <div class="word-slider">
        <button class="prev-btn">❮</button>
        <div class="word-container">
            <div class="word-slide">
                <img src="~/Content/images/motorbike.png" alt="Word1"><a>Miễn phí vận chuyển</a>
            </div>
            <div class="word-slide">
                <img src="~/Content/images/gift.png" alt="Word2"><a>Quà tặng hấp dẫn</a>
            </div>
            <div class="word-slide">
                <img src="~/Content/images/star.png" alt="Word3"><a>Hàng chính hãng, đảm bảo chất lượng</a>
            </div>
            <div class="word-slide">
                <img src="~/Content/images/lightning.png" alt="Word4"><a>Mua ngay kẻo lỡ</a>
            </div>
        </div>
        <button class="next-btn">❯</button>
    </div>



    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let currentIndex = 0;
            const slides = document.querySelectorAll(".word-slide");
            const totalSlides = slides.length;
            const sliderContainer = document.querySelector(".word-container");
            let autoSlide;

            function updateSlide() {
                sliderContainer.style.transition = "transform 0.5s ease-in-out";
                sliderContainer.style.transform = `translateX(-${currentIndex * 100}%)`;
            }

            function nextSlide() {
                currentIndex = (currentIndex + 1) % totalSlides;
                updateSlide();
            }

            function prevSlide() {
                currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
                updateSlide();
            }

            function resetAutoSlide() {
                clearInterval(autoSlide);
                autoSlide = setInterval(nextSlide, 5000);
            }

            document.querySelector(".next-btn").addEventListener("click", function () {
                nextSlide();
                resetAutoSlide();
            });

            document.querySelector(".prev-btn").addEventListener("click", function () {
                prevSlide();
                resetAutoSlide();
            });

            // Khởi động auto slide ngay từ đầu
            autoSlide = setInterval(nextSlide, 5000);
        });


    </script>

    <div class="featured-products">
        <h2 class="text-center">Sản phẩm Nổi Bật</h2>
        <div class="product-list d-flex justify-content-center flex-wrap">
            @if (ViewBag.Products != null && ViewBag.Products.Count > 0)
            {
                foreach (var product in ViewBag.Products)
                {
                    var productImage = !string.IsNullOrEmpty(product.ImageURL) ? product.ImageURL : "/Content/images/default-product.png";

                    <div class="product-item text-center">
                        <img src="@Url.Content(productImage)" alt="@product.ProductName" class="product-image">
                        <h3>@product.ProductName</h3>
                        <p>Giá: @product.Price.ToString("N0") VNĐ</p>
                        <a href="@Url.Action("Detail", "Detail", new { id = product.ProductID })" class="btn btn-primary">Xem ngay</a>
                    </div>
                }
            }
            else
            {
                <p class="text-center">Chưa có sản phẩm nổi bật nào.</p>
            }
        </div>
    </div>

    <div class="news-section">
        <h2 class="text-center">Tin tức Mới Nhất</h2>
        <div class="news-list d-flex justify-content-center flex-wrap">

            <div class="news-item">
                <img src="~/Content/images/blog.png" alt="Xu hướng thời trang hè 2025" class="news-image">
                <h3>Xu hướng thời trang hè 2025</h3>
                <p>Những bộ sưu tập mới nhất đang làm mưa làm gió trong mùa hè này.</p>
                <a href="@Url.Action("DetailBlog1", "Blog")" class="btn btn-outline-primary">Đọc tiếp</a>
            </div>

            <div class="news-item">
                <img src="~/Content/images/blog1.jpg" alt="Mẹo phối đồ" class="news-image">
                <h3>Mẹo phối đồ</h3>
                <p>Gợi ý cách mix đồ thanh lịch, chuyên nghiệp cho các tín đồ thời trang.</p>
                <a href="@Url.Action("DetailBlog2", "Blog")" class="btn btn-outline-primary">Đọc tiếp</a>
            </div>

            <div class="news-item">
                <img src="~/Content/images/blog2.png" alt="Top 5 đôi giày hot nhất 2025" class="news-image">
                <h3>Top 5 đôi giày hot nhất 2025</h3>
                <p>Những đôi sneaker không thể bỏ lỡ trong năm nay.</p>
                <a href="@Url.Action("DetailBlog3", "Blog")" class="btn btn-outline-primary">Đọc tiếp</a>
            </div>

            <div class="news-item">
                <img src="~/Content/images/blog3.jpg" alt="Top 10 thương hiệu thời trang nổi bật năm 2025" class="news-image">
                <h3>Top 10 thương hiệu thời trang nổi bật năm 2025</h3>
                <p>Cập nhật những thương hiệu thời trang được yêu thích và tiên phong trong xu hướng năm nay.</p>
                <a href="@Url.Action("DetailBlog4", "Blog")" class="btn btn-outline-primary">Đọc tiếp</a>
            </div>

            <div class="news-item">
                <img src="~/Content/images/blog4.jpg" alt="Thời trang 2025: Xu hướng toàn cầu cho nam nữ." class="news-image">
                <h3>Thời trang 2025: Xu hướng toàn cầu cho nam nữ</h3>
                <p>Khám phá xu hướng thời trang 2025, từ đường phố đến sàn diễn haute couture.</p>
                <a href="@Url.Action("DetailBlog5", "Blog")" class="btn btn-outline-primary">Đọc tiếp</a>
            </div>

        </div>
    </div>


    @Html.Partial("_Footer")

</body>
</html>
