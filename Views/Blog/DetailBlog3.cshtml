@{
    Layout = null;
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Top 5 Đôi Giày Hot Nhất 2025</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/css/blogdetail.css")" />
</head>

@Html.Partial("_Header")
<div class="blog-detail-container">
    <div class="blog-detail">
        <h1 class="blog-detail-title">Top 5 Đôi Giày Hot Nhất 2025</h1>
        <img src="@Url.Content("~/Content/images/blog2.png")" alt="Top 5 đôi giày hot nhất 2025" class="blog-detail-image">
        <p class="blog-detail-description">Năm 2025, các mẫu giày thể thao (sneaker) đang chiếm lĩnh thị trường và trở thành món đồ không thể thiếu trong tủ đồ của các tín đồ thời trang. Dưới đây là top 5 đôi giày sneaker nổi bật nhất mà bạn không thể bỏ lỡ trong năm nay.</p>

        <h2 class="blog-detail-subtitle">1. Nike Air Max 2025</h2>
        <p class="blog-detail-content">Nike Air Max 2025 là một trong những mẫu giày sneaker được săn đón nhất năm nay. Với thiết kế nổi bật và công nghệ Air Max hiện đại, đôi giày này không chỉ mang lại sự thoải mái mà còn thể hiện phong cách trẻ trung, năng động.</p>
        <img src="@Url.Content("~/Content/images/blog3/3.1.jpg")" alt="Nike Air Max 2025" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">2. Adidas Ultraboost 2025</h2>
        <p class="blog-detail-content">Adidas Ultraboost luôn là một cái tên quen thuộc trong các danh sách giày thể thao hot nhất. Phiên bản 2025 tiếp tục cải tiến với lớp đệm Boost cực kỳ êm ái, giúp người sử dụng cảm giác thoải mái dù mang cả ngày dài.</p>
        <img src="@Url.Content("~/Content/images/blog3/3.2.jpg")" alt="Adidas Ultraboost 2025" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">3. Puma RS-X 2025</h2>
        <p class="blog-detail-content">Với phong cách retro và màu sắc bắt mắt, Puma RS-X 2025 nổi bật với thiết kế thể thao đầy ấn tượng. Đây là một lựa chọn tuyệt vời cho những ai yêu thích sự phá cách trong thời trang giày sneaker.</p>
        <img src="@Url.Content("~/Content/images/blog3/3.3.jpg")" alt="Puma RS-X 2025" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">4. New Balance 990v5</h2>
        <p class="blog-detail-content">New Balance 990v5 nổi bật với thiết kế cổ điển, mang lại sự thoải mái và độ bền cao. Đây là một lựa chọn hoàn hảo cho những ai yêu thích sự đơn giản nhưng vẫn sang trọng và thời trang.</p>
        <img src="@Url.Content("~/Content/images/blog3/3.4.jpg")" alt="New Balance 990v5" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">5. Reebok Zig Kinetica</h2>
        <p class="blog-detail-content">Reebok Zig Kinetica với thiết kế táo bạo và những đường nét độc đáo, mang lại cảm giác mới mẻ cho những người yêu thích sự khác biệt. Đây là một trong những mẫu giày nổi bật trong năm nay với sự kết hợp giữa thể thao và thời trang hiện đại.</p>
        <img src="@Url.Content("~/Content/images/blog3/3.5.png")" alt="Reebok Zig Kinetica" class="blog-detail-image center-image" style="width: auto;">

        <a href="@Url.Action("Blog", "Blog")" class="blog-btn">Quay lại</a>
    </div>
</div>
@Html.Partial("_Footer")
