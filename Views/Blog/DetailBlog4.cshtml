@{
    Layout = null;
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Top 10 Thương Hiệu Thời Trang Nổi Bật Năm 2025</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/css/blogdetail.css")" />
</head>


@Html.Partial("_Header")
<div class="blog-detail-container">
    <div class="blog-detail">
        <h1 class="blog-detail-title">Top 10 Thương Hiệu Thời Trang Nổi Bật Năm 2025</h1>
        <img src="@Url.Content("~/Content/images/blog3.jpg")" alt="Top 10 thương hiệu thời trang nổi bật năm 2025" class="blog-detail-image">
        <p class="blog-detail-description">Thị trường thời trang năm 2025 chứng kiến sự lên ngôi của các thương hiệu tiên phong trong việc thay đổi xu hướng, đưa ra các bộ sưu tập sáng tạo và có ảnh hưởng lớn đến cộng đồng. Dưới đây là 10 thương hiệu thời trang nổi bật nhất năm nay.</p>

        <h2 class="blog-detail-subtitle">1. Gucci</h2>
        <p class="blog-detail-content">Gucci tiếp tục khẳng định vị thế của mình với những thiết kế đột phá và các bộ sưu tập đầy màu sắc. Các sản phẩm của Gucci không chỉ mang đến sự sang trọng mà còn là biểu tượng của sự sáng tạo và đổi mới.</p>
        <img src="@Url.Content("~/Content/images/blog4/4.1.jpg")" alt="Gucci" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">2. Louis Vuitton</h2>
        <p class="blog-detail-content">Louis Vuitton tiếp tục dẫn đầu xu hướng thời trang cao cấp với các bộ sưu tập hoàn hảo, phù hợp với nhu cầu của những tín đồ yêu thích sự sang trọng và tinh tế.</p>
        <img src="@Url.Content("~/Content/images/blog4/4.2.png")" alt="Louis Vuitton" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">3. Balenciaga</h2>
        <p class="blog-detail-content">Balenciaga luôn mang đến những thiết kế táo bạo và độc đáo, phù hợp với những người yêu thích sự khác biệt và phá cách trong thời trang.</p>
        <img src="@Url.Content("~/Content/images/blog4/4.3.png")" alt="Balenciaga" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">4. Chanel</h2>
        <p class="blog-detail-content">Chanel tiếp tục khẳng định đẳng cấp của mình trong thế giới thời trang cao cấp, với những bộ sưu tập mang tính biểu tượng và vượt thời gian.</p>
        <img src="@Url.Content("~/Content/images/blog4/4.4.png")" alt="Chanel" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">5. Prada</h2>
        <p class="blog-detail-content">Prada với phong cách tối giản nhưng đầy sang trọng, tiếp tục trở thành thương hiệu yêu thích của các tín đồ thời trang cao cấp trên toàn thế giới.</p>
        <img src="@Url.Content("~/Content/images/blog4/4.5.png")" alt="Prada" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">6. Off-White</h2>
        <p class="blog-detail-content">Off-White luôn đi đầu trong việc kết hợp thời trang cao cấp và phong cách đường phố, với các thiết kế nổi bật và đầy sáng tạo.</p>
        <img src="@Url.Content("~/Content/images/blog4/4.6.png")" alt="Off-White" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">7. Fendi</h2>
        <p class="blog-detail-content">Fendi không chỉ nổi bật trong các bộ sưu tập thời trang cao cấp mà còn thu hút sự chú ý với những thiết kế chất liệu cao cấp và họa tiết đặc trưng.</p>
        <img src="@Url.Content("~/Content/images/blog4/4.7.png")" alt="Fendi" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">8. Valentino</h2>
        <p class="blog-detail-content">Valentino luôn mang đến những thiết kế thanh lịch và sang trọng, là lựa chọn hàng đầu của những tín đồ yêu thích sự nữ tính và quý phái.</p>
        <img src="@Url.Content("~/Content/images/blog4/4.8.png")" alt="Valentino" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">9. Alexander McQueen</h2>
        <p class="blog-detail-content">Alexander McQueen là thương hiệu nổi bật với những thiết kế táo bạo và nghệ thuật, luôn mang đến các bộ sưu tập đầy ấn tượng và sáng tạo.</p>
        <img src="@Url.Content("~/Content/images/blog4/4.9.jpg")" alt="Alexander McQueen" class="blog-detail-image center-image" style="width: auto;">

        <h2 class="blog-detail-subtitle">10. Saint Laurent</h2>
        <p class="blog-detail-content">Saint Laurent luôn nổi bật với những thiết kế thời trang đầy cá tính và sắc sảo, là sự lựa chọn của những ai yêu thích sự thanh lịch và mạnh mẽ.</p>
        <img src="@Url.Content("~/Content/images/blog4/4.10.jpg")" alt="Saint Laurent" class="blog-detail-image center-image" style="width: auto;">

        <a href="@Url.Action("Blog", "Blog")" class="blog-btn">Quay lại</a>
    </div>
</div>
@Html.Partial("_Footer")
