@{
    Layout = null;
}
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kết quả tìm kiếm</title>
    <link rel="stylesheet" href="~/Content/css/seacrh.css" />
</head>
@Html.Partial("_Header")
<h2>Kết quả tìm kiếm cho: <span class="search-keyword">@ViewBag.Keyword</span></h2>

@if (Model.Count == 0)
{
    <div class="no-results">
        <img src="~/Content/images/not-found.png" alt="Không tìm thấy sản phẩm" class="no-results-image" />
        <h3>Rất tiếc! Không tìm thấy sản phẩm nào.</h3>
        <p>Hãy thử tìm với từ khóa khác hoặc khám phá danh mục sản phẩm của chúng tôi.</p>
        <a href="@Url.Action("Home", "Home")" class="btn-back-home">Quay về trang chủ</a>
    </div>
}

else
{
    <div class="product-list">
        @foreach (var product in Model)
        {
            <div class="product-item">
                <img src="@Url.Content(product.ImageURL)" alt="@product.ProductName" class="product-image" />
                <h3>@product.ProductName</h3>
                <p class="price">Giá: @product.Price.ToString("N0") VNĐ</p>
                <a href="@Url.Action("Detail", "Detail", new { id = product.ProductID })" class="btn-choose">Xem chi tiết</a>
            </div>
        }
    </div>
}
@Html.Partial("_Footer")
