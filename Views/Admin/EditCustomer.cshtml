@model WebMusic.Models.Customer

@{
    Layout = null;
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Chỉnh sửa khách hàng</title>
    <link rel="stylesheet" href="~/Content/css/addcategory.css" />
    <script src="~/Content/js/previewimage.js"></script>
</head>

<div class="container">
    <h4>Chỉnh sửa khách hàng</h4>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form action="@Url.Action("EditCustomer", "Admin")" method="post" enctype="multipart/form-data">
        @Html.HiddenFor(model => model.CustomerID)

        <div class="form-group">
            <label for="FullName">Họ và tên</label>
            @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            <label for="Email">Email</label>
            @Html.TextBoxFor(model => model.Email, new { @class = "form-control", @readonly = "readonly" })
        </div>

        <div class="form-group">
            <label for="Phone">Số điện thoại</label>
            @Html.TextBoxFor(model => model.Phone, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            <label for="Address">Địa chỉ</label>
            @Html.TextBoxFor(model => model.Address, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            <label for="avatarFile">Ảnh đại diện</label>
            <input type="file" name="avatarFile" id="avatarFile" class="form-control" accept="image/*" onchange="previewImage(event)" />

            @if (!string.IsNullOrEmpty(Model.Avatar))
            {
                <img id="avatarPreview" src="@Url.Content(Model.Avatar)" alt="Ảnh đại diện" class="img-preview" style="max-width: 200px; display: block; margin-top: 10px;" />
            }
            else
            {
                <img id="avatarPreview" src="#" alt="Xem trước ảnh" class="img-preview" style="max-width: 200px; display: none; margin-top: 10px;" />
            }
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-default">Lưu thay đổi</button>
            <a href="@Url.Action("ManagerUser", "Admin")" class="btn btn-danger">Hủy</a>
        </div>
    </form>
</div>
