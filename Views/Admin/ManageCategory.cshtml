
@{
    Layout = null;
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>ManageCategory</title>
    <link rel="stylesheet" href="~/Content/css/manageproduct.css" />
    <script src="~/Content/js/successmessage.js"></script>

</head>
@Html.Partial("_HeaderAdmin")


<div class="main-content">
    <p>Danh sách danh mục</p>

    @if (Model.Count > 0)
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên thể loại</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            @if (TempData["SuccessMessage"] != null)
            {
                <div id="success-message" class="alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }
            <tbody>
                @{ int stt = 1; }
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@category.CategoryName</td>
                        <td>
                            <a href="@Url.Action("EditCategory", "Admin", new { id = category.CategoryID })" class="btn btn-warning">Sửa</a>
                            <form action="@Url.Action("DeleteCategory", "Admin")" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@category.CategoryID" />
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">Xóa</button>
                            </form>
                        </td>
                    </tr>
                    stt++;
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-center text-muted">Chưa có danh mục nào.</p>
    }

    <a href="@Url.Action("AddCategory", "Admin")" class="btn btn-primary">Thêm danh mục</a>
</div>

