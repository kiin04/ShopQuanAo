@model WebMusic.Models.Category

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>AddCategory</title>
    <link rel="stylesheet" href="~/Content/css/addcategory.css" />
</head>
<body>
    <div class="container">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <h4>Thêm Danh Mục</h4>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.Label("Tên Danh Mục")
                @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên danh mục" } })
                @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-default">Thêm danh mục</button>
        }

        <a href="@Url.Action("ManageCategory", "Admin")" class="back-link">Quay lại danh sách</a>
    </div>
</body>
</html>
