@model WebMusic.Models.Category
@{
    Layout = null;
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>EditCategory</title>
    <link rel="stylesheet" href="~/Content/css/addcategory.css" />
</head>

<div class="container">
    <h4>Chỉnh sửa danh mục</h4>

    <form action="@Url.Action("EditCategory", "Admin")" method="post">
        @Html.HiddenFor(model => model.CategoryID)

        <div class="form-group">
            <label for="CategoryName">Tên danh mục</label>
            @Html.TextBoxFor(model => model.CategoryName, new { @class = "form-control", required = "required" })
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-default">Lưu thay đổi</button>
        </div>
    </form>

    <a href="@Url.Action("ManageCategory", "Admin")" class="back-link">Quay lại danh sách</a>
</div>