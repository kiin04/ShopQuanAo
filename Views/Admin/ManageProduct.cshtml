@using WebMusic.Models
@model PagedList.IPagedList<Product>
@using PagedList.Mvc
@{
    Layout = null;
}
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ManageProduct</title>
    <link rel="stylesheet" href="~/Content/css/manageproduct.css" />
    <script src="~/Content/js/successmessage.js"></script>
</head>

@Html.Partial("_HeaderAdmin")
<div class="main-content">
    <p>Danh sách sản phẩm</p>
    @if (Model.Count > 0)
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Mô tả</th>
                    <th>Ảnh</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            @if (TempData["SuccessMessage"] != null)
            {
                <div id="success-message" class="alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }
            <tbody>
                @{ int stt = (Model.PageNumber - 1) * Model.PageSize + 1; }
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@product.ProductName</td>
                        <td>@product.Category.CategoryName</td>
                        <td>@product.Price.ToString("N0") VNĐ</td>
                        <td>@product.Stock</td>
                        <td class="description-cell" title="@product.Description">@product.Description</td>
                        <td>
                            @{
                                var imageUrl = !string.IsNullOrEmpty(product.ImageURL) ? Url.Content(product.ImageURL) : "/Content/images/no-image.png";
                            }
                            <img src="@imageUrl" width="50" height="50" onerror="this.onerror=null;this.src='/Content/images/no-image.png';" />
                        </td>
                        <td>
                            <a href="@Url.Action("EditProduct", "Admin", new { id = product.ProductID })" class="btn btn-warning">Sửa</a>
                            <form action="@Url.Action("DeleteProduct", "Admin")" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@product.ProductID" />
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">Xóa</button>
                            </form>
                        </td>
                    </tr>
                    stt++;
                }
            </tbody>
        </table>
        <div class="pagination-container">
            @Html.PagedListPager(Model, page => Url.Action("ManageProduct", new { page }),
                new PagedListRenderOptions
                {
                    Display = PagedListDisplayMode.IfNeeded,
                    DisplayPageCountAndCurrentLocation = false,
                    MaximumPageNumbersToDisplay = 5,
                    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                    DisplayLinkToNextPage = PagedListDisplayMode.Always
                })
        </div>
    }
    else
    {
        <p class="text-center text-muted">Chưa có sản phẩm nào.</p>
    }

    <a href="@Url.Action("AddProduct", "Admin")" class="btn btn-primary">Thêm sản phẩm</a>
</div>
