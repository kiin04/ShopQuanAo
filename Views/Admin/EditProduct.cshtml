@model WebMusic.Models.Product

@{
    Layout = null;
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Chỉnh sửa sản phẩm</title>
    <link rel="stylesheet" href="~/Content/css/addcategory.css" />
    <script src="~/Content/js/previewimage.js"></script>

</head>

<div class="container">
    <h4>Chỉnh sửa sản phẩm</h4>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
<form action="@Url.Action("EditProduct", "Admin")" method="post" enctype="multipart/form-data">
    @Html.HiddenFor(model => model.ProductID)

    <div class="form-group">
        <label for="ProductName">Tên sản phẩm</label>
        @Html.TextBoxFor(model => model.ProductName, new { @class = "form-control", required = "required" })
    </div>

    <div class="form-group">
        <label for="CategoryID">Danh mục</label>
        @Html.DropDownListFor(model => model.CategoryID, ViewBag.Categories as SelectList, "Chọn danh mục", new { @class = "form-control", required = "required" })
    </div>

    <div class="form-group">
        <label for="Price">Giá</label>
        @Html.TextBoxFor(model => model.Price, new { @class = "form-control", type = "number", required = "required", step = "0.01" })
    </div>

    <div class="form-group">
        <label for="Stock">Số lượng</label>
        @Html.TextBoxFor(model => model.Stock, new { @class = "form-control", type = "number", required = "required" })
    </div>

    <div class="form-group">
        <label for="Description">Mô tả</label>
        @Html.TextAreaFor(model => model.Description, new { @class = "form-control fixed-textarea", rows = 5 })
    </div>

    <div class="form-group">
        <label for="ImageUpload">Hình ảnh</label>
        <input type="file" name="ImageUpload" id="ImageUpload" class="form-control" accept="image/*" onchange="previewImage(event)" />

        @if (!string.IsNullOrEmpty(Model.ImageURL))
        {
            <img id="imagePreview" src="@Url.Content(Model.ImageURL)" alt="Hình ảnh sản phẩm" class="img-preview" style="max-width: 200px; display: block; margin-top: 10px;" />
        }
        else
        {
            <img id="imagePreview" src="#" alt="Xem trước hình ảnh" class="img-preview" style="max-width: 200px; display: none; margin-top: 10px;" />
        }
    </div>
    <script src="~/Content/js/previewimage.js"></script>


    <div class="button-group">
        <button type="submit" class="btn btn-default">Lưu thay đổi</button>
        <a href="@Url.Action("ManageProduct", "Admin")" class="btn btn-danger">Hủy</a>
    </div>
</form>
</div>
