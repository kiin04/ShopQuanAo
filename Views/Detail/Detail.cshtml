@{
    Layout = null;
    var comments = ViewBag.Comments as List<WebMusic.Models.Comment>;
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Detail</title>
    <link rel="stylesheet" href="~/Content/css/detail.css" />
    <script src="~/Content/js/comment.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

</head>

@Html.Partial("_Header")

<div class="product-container">
    <div class="product-content">
        <!-- Hình ảnh sản phẩm bên trái -->
        <img src="@ViewBag.ImageURL" alt="@ViewBag.ProductName" class="product-image">

        <!-- Thông tin sản phẩm bên phải -->
        <div class="product-details">
            <h2>@ViewBag.ProductName</h2>
            <p><strong>Giá:</strong> @ViewBag.Price.ToString("N0") VNĐ</p>
            <p><strong>Kho hàng:</strong> @ViewBag.Stock</p>
            <p><strong>Danh mục:</strong> @ViewBag.CategoryName</p>

            <!-- Nhóm chọn số lượng và thêm vào giỏ hàng -->
            <div class="action-group">
                @{
                    if (ViewBag.Stock > 0)
                    {
                        <input type="number" id="quantity" class="quantity-input" value="1" min="1" max="@ViewBag.Stock">
                        <button class="btnAdd" onclick="addToCart()">Thêm vào giỏ hàng</button>

                        if (ViewBag.Stock <= 10)
                        {
                            <p class="low-stock-warning" style="color: red;">⚠️ Chỉ còn @ViewBag.Stock sản phẩm!</p>
                        }
                    }
                    else
                    {
                        <p class="out-of-stock" style="color: red; font-weight: bold;">Sản phẩm đã hết hàng!</p>
                    }
                }
            </div>

        </div>
    </div>

    <!-- Mô tả sản phẩm được đặt trong khung -->
    <div class="description-box">
        <h3>Mô tả sản phẩm:</h3>
        <p>@ViewBag.Description</p>
    </div>

    <div class="comment-section">
        <h3>Bình luận</h3>

        @if (Session["Email"] != null)
        {
            <div class="comment-form">
                <textarea id="commentText" placeholder="Viết bình luận..."></textarea>
                <button onclick="submitComment()">Gửi bình luận</button>
            </div>
        }
        else
        {
            <p class="login-required">Bạn cần <a href="@Url.Action("Login", "Login")">đăng nhập</a> mới có thể bình luận.</p>
        }

        <div id="comments">
            @if (ViewBag.Comments == null || !((List<WebMusic.Models.Comment>)ViewBag.Comments).Any())
            {
                <p class="no-comments">Chưa có bình luận nào.</p>
            }
            else
            {
                foreach (var comment in (List<WebMusic.Models.Comment>)ViewBag.Comments)
                {
                    <div class="comment">
                        <p><strong>@comment.Customer.FullName:</strong> @comment.CommentText</p>
                        <small>@comment.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</small>

                        @if (Session["Email"] != null)
                        {
                            <button class="reply-btn" onclick="showReplyForm(@comment.CommentID)">Trả lời</button>

                            <div id="replyForm-@comment.CommentID" class="reply-form" style="display: none;">
                                <textarea id="replyText-@comment.CommentID" placeholder="Viết trả lời..."></textarea>
                                <button onclick="submitReply(@comment.CommentID)">Gửi</button>
                            </div>
                        }

                        @if (comment.Comments1 != null && comment.Comments1.Any())
                        {
                            <div class="replies">
                                @foreach (var reply in comment.Comments1)
                                {
                                    <div class="reply">
                                        <p><strong>@reply.Customer.FullName:</strong> @reply.CommentText</p>
                                        <small>@reply.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <script>
    function showReplyForm(commentId) {
        let replyForm = document.getElementById("replyForm-" + commentId);
        if (replyForm.style.display === "none") {
            replyForm.style.display = "block";
        } else {
            replyForm.style.display = "none";
        }
    }

    function submitReply(parentCommentId) {
        let replyText = document.getElementById("replyText-" + parentCommentId).value;
        let productId = "@ViewBag.ProductID"; // Chuyển thành chuỗi hợp lệ

        if (replyText.trim() === "") {
            alert("Nội dung không được để trống.");
            return;
        }

        $.ajax({
            type: "POST",
            url: "/Detail/ReplyComment",
            data: { productId: productId, commentText: replyText, parentCommentId: parentCommentId },
            success: function (response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert(response.message);
                }
            },
            error: function () {
                alert("Có lỗi xảy ra khi gửi bình luận.");
            }
        });
    }
    </script>

    <script>
    var commentUrl = '@Url.Action("AddComment", "Detail")';
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("commentText").setAttribute("data-product-id", @ViewBag.ProductID);
    });

    </script>


</div>

@Html.Partial("_Footer")

<script>
function addToCart() {
    let productId = "@ViewBag.ProductID";
    let quantity = document.getElementById("quantity").value;
    let stock = parseInt("@ViewBag.Stock");

    if (stock === 0) {
        alert("Sản phẩm đã hết hàng!");
        return;
    }

    if (quantity > stock) {
        alert("Số lượng đặt hàng vượt quá số lượng tồn kho!");
        return;
    }

    $.ajax({
        type: "POST",
        url: "/Cart/AddToCart",
        data: { productId: productId, quantity: quantity },
        success: function (response) {
            if (!response.success) {
                alert(response.message);
                if (response.message.includes("đăng nhập")) {
                    window.location.href = "/Login/Login";
                }
            } else {
                alert(response.message);
            }
        },
        error: function () {
            alert("Có lỗi xảy ra khi thêm sản phẩm.");
        }
    });
}
</script>